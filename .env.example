# Escolha o provedor do LLM: "gemini" ou "openai"
LLM_PROVIDER=gemini

# Modelo (opcional). Padrões: gemini-3.5-flash / gpt-4o-mini
# LLM_MODEL=gemini-3.5-flash

# Preencha apenas a chave do provedor escolhido
GOOGLE_API_KEY=sua-chave-aqui
OPENAI_API_KEY=

# Quantas trocas de mensagens (pergunta + resposta) o agente lembra
MEMORY_WINDOW=10
